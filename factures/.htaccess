# Factures FLP — règles du dossier /factures
# Annule l'éventuelle redirection héritée du dossier parent (voir htaccess.txt du site).
RewriteEngine On

# Force https
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Le manifeste installable (servi par manifest.php)
RewriteRule ^manifest\.webmanifest$ manifest.php [L]

# Adresse courte de l'app photo : /factures/scan (et /factures/scan/)
RewriteRule ^scan/?$ scan.php [L]
# Fichier d'une facture sous son vrai nom : /factures/f/12/2026-10-24_vito_68,10_12.pdf
RewriteRule ^f/(\d+)/[^/]*$ api.php?a=file&id=$1 [QSA,L]
# Écran de lancement de l'appli installée : /factures/accueil
RewriteRule ^accueil/?$ accueil.php [L]

# Vitesse : fichiers de l'appli gardés en cache par le téléphone (leur adresse change à chaque mise à jour : ?v=…)
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
# Vitesse : compression des pages, styles et scripts
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/manifest+json image/svg+xml
</IfModule>

# Pas d'indexation par les moteurs
Header set X-Robots-Tag "noindex, nofollow" env=REDIRECT_STATUS

# Fichiers internes : jamais appelés directement
<FilesMatch "^(updater\.php|lib\.php|config\.php|VERSION)$|\.(maj|tmp\w*)$">
  Require all denied
</FilesMatch>

# Page d'accueil du dossier
DirectoryIndex index.php

# Stoppe ici : aucune autre règle héritée ne s'applique
RewriteRule ^$ index.php [L]
RewriteRule .* - [L]
